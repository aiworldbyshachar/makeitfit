{
  "name": "MakeItFit",
  "short_name": "MakeItFit",
  "description": "Drop photos or PDFs, type the size limit, get one file that fits - made in your browser, nothing uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
